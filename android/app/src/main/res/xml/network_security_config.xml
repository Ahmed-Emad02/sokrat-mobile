        <domain includeSubdomains="true">192.168.100.215</domain>
        <domain includeSubdomains="true">192.168.100.216</domain>
        <domain includeSubdomains="true">192.168.100.218</domain>
        <domain includeSubdomains="true">100.91.135.84</domain>
        <domain includeSubdomains="true">issabel.local</domain>
        <domain includeSubdomains="true">localhost</domain>
